{
  "name": "rss-reader-proxy",
  "main": "server/proxy.js",
  "compatibility_date": "2026-05-12",
  "workers_dev": false,
  "$schema": "./node_modules/wrangler/config-schema.json",
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "src",
      "index.html",
      "vite.config.js"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "keep_vars": true,
  "preview_urls": false
}
